# ============================================================
# Qwen MCP Server — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# Or set these in Claude Desktop's mcpServers env config

# Your Qwen API endpoint (OpenAI-compatible)
QWEN_BASE_URL=http://localhost:11434/v1

# Your API key
QWEN_API_KEY=no-key

# Model name to use
QWEN_MODEL=qwen2.5-coder:14b

# Request timeout in seconds
QWEN_TIMEOUT=300
